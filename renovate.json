{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "cloudflared イメージの新バージョンを PR 化し、deploy の plan が通れば自動マージする",
  "enabledManagers": ["kubernetes"],
  "kubernetes": {
    "managerFilePatterns": ["/^infrastructure/cloudflare/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "壊れたリリースを掴まないよう公開から 3 日待つ",
      "matchPackageNames": ["cloudflare/cloudflared"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    }
  ]
}

# 全 arch 共通の world。2026-11-25 の全台実測 (apk world) を正とし、
# ドリフト (smartmontools の有無) は「全台に入れる」で統一した。
# ここに無いパッケージはホストに入らない。
alpine-base
bash
blkid
busybox-mdev-openrc
coreutils
curl
dosfstools
e2fsprogs
# resize2fs は e2fsprogs ではなくこちら (firstboot の rootfs 拡張に必須)
e2fsprogs-extra
findutils
iptables
mount
openssh
openssl
smartmontools
util-linux
wireless-regdb
# 以下は現行に無い新規分 (硬化と管理用)
# Ansible の実行に必須
python3
sudo
nftables
ca-certificates
tzdata
jq
cloud-utils-growpart
# util-linux はメタパッケージで中身を引かないため、firstboot が使うものは明示
findmnt
lsblk

#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034
# Cloudflare Tunnel を token-file で起動する。サービス名ごとに token を分ける:
#   cf-tunnel      → /etc/cloudflared/cf-tunnel.token      (台ごとの SSH 用、全台)
#   cf-tunnel.api  → /etc/cloudflared/cf-tunnel.api.token  (k3s API 用、server のみ)
# cf-tunnel.api は cf-tunnel への symlink (OpenRC の多重インスタンス)。
# トークンが無い台では start_pre で静かに失敗する (通常運用に影響しない)。

name="cloudflared tunnel"
description="Cloudflare Tunnel (${RC_SVCNAME})"
command="/usr/bin/cloudflared"
token_file="/etc/cloudflared/${RC_SVCNAME}.token"
command_args="tunnel --no-autoupdate run --token-file ${token_file}"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
# /var/log は 256M の tmpfs。ファイルに直接吐くと無制限に伸びるので syslog
# (busybox syslogd がサイズでローテートする) に流す
output_logger="logger -t ${RC_SVCNAME} -p daemon.info"
error_logger="logger -t ${RC_SVCNAME} -p daemon.err"

depend() {
  need net
  after firewall
}

start_pre() {
  [ -s "$token_file" ] || { eerror "no tunnel token: $token_file"; return 1; }
}

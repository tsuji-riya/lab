#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034
# Cloudflare Tunnel (リモート管理トンネル) を token-file で起動する。
# トークンが無い台では start_pre で静かに失敗する (通常運用に影響しない)。

name="cloudflared tunnel"
description="Cloudflare Tunnel for SSH access"
command="/usr/bin/cloudflared"
command_args="tunnel --no-autoupdate run --token-file /etc/cloudflared/token"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
# /var/log は 64M の tmpfs。ファイルに直接吐くと無制限に伸びるので syslog
# (busybox syslogd がサイズでローテートする) に流す
output_logger="logger -t cloudflared -p daemon.info"
error_logger="logger -t cloudflared -p daemon.err"

depend() {
  need net
  after firewall
}

start_pre() {
  [ -s /etc/cloudflared/token ] || { eerror "no tunnel token"; return 1; }
}

#!/bin/sh
# 初回起動時のみ: 焼き込み時に注入された node.conf から identity を適用する。
# node.conf の探索先: Pi の /boot、x86 の EFI パーティション (/boot/efi)。
set -eu
MARKER=/etc/lab-firstboot-done
[ -f "$MARKER" ] && exit 0

# 失敗箇所を後から追えるよう、実行ログを残す (set -x つき)
exec > /var/log/node-firstboot.log 2>&1
set -x

CONF=""
for p in /boot/node.conf /boot/efi/node.conf /media/*/node.conf; do
  [ -f "$p" ] && CONF="$p" && break
done
[ -n "$CONF" ] || { echo "node.conf not found, skipping"; exit 0; }

# NODE_HOSTNAME= / NODE_IP= / NODE_GATEWAY= / NODE_ROLE=
. "$CONF"

# SSH ホスト鍵をこの台専用に生成 (image には焼いていない)
[ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A

# 管理用公開鍵は node.conf 経由で受け取る (Git にも image にも入れない)
if [ -n "${SSH_PUBKEY:-}" ]; then
  mkdir -p /home/riya/.ssh
  echo "$SSH_PUBKEY" > /home/riya/.ssh/authorized_keys
  chmod 700 /home/riya/.ssh
  chmod 600 /home/riya/.ssh/authorized_keys
  chown -R riya:riya /home/riya
fi

hostname "$NODE_HOSTNAME"
echo "$NODE_HOSTNAME" > /etc/hostname
cat > /etc/network/interfaces <<EOF
auto lo
iface lo inet loopback
auto eth0
iface eth0 inet static
  address ${NODE_IP}
  netmask 255.255.255.0
  gateway ${NODE_GATEWAY:-192.168.1.1}
EOF
grep -q "${NODE_HOSTNAME}" /etc/hosts || echo "${NODE_IP} ${NODE_HOSTNAME}" >> /etc/hosts

# DNS はゲートウェイ (ルーター) を指す。書かないと名前解決が全滅する
printf 'nameserver %s\n' "${NODE_GATEWAY:-192.168.1.1}" > /etc/resolv.conf

# root パーティションをディスク末尾まで拡張 (image は 4G で作るため)
ROOT_DEV=$(findmnt -no SOURCE / || true)
DISK=$(lsblk -no PKNAME "$ROOT_DEV" || true)
PARTNO=$(echo "$ROOT_DEV" | grep -o '[0-9]*$')
if [ -n "$DISK" ] && [ -n "$PARTNO" ] && [ -n "$ROOT_DEV" ]; then
  DISK_BYTES=$(lsblk -bno SIZE "/dev/$DISK" || true)
  PART_BYTES=$(lsblk -bno SIZE "$ROOT_DEV" || true)
  # パーティションがディスクより 16MiB 以上小さければテーブルを伸ばす。
  # parted の resizepart はマウント中 root で反映されなかった (実機) ため
  # sfdisk でテーブルを書き、partx -u (BLKPG) でカーネルへ伝える
  if [ -n "$DISK_BYTES" ] && [ -n "$PART_BYTES" ] && [ "$PART_BYTES" -lt $((DISK_BYTES - 16777216)) ]; then
    printf ', +\n' | sfdisk -N "$PARTNO" "/dev/$DISK" || true
    partx -u "/dev/$DISK" || true
  fi
  resize2fs "$ROOT_DEV" || true
  # それでも FS が小さいままならマーカーを書かず、次回起動で再試行する
  FS_BYTES=$(df -B1 / | awk 'NR==2 {print $2}')
  PART_BYTES=$(lsblk -bno SIZE "$ROOT_DEV" || true)
  if [ -n "$FS_BYTES" ] && [ -n "$PART_BYTES" ] && [ "$FS_BYTES" -lt $((PART_BYTES - 16777216)) ]; then
    echo "root fs not grown yet (fs=$FS_BYTES part=$PART_BYTES), retry on next boot"
    exit 0
  fi
fi

# Cloudflare Tunnel (GitHub Actions からの SSH 到達用)。トークンは
# node.conf 経由で焼き込み時にだけ渡し、ファイルに置いてサービス起動
if [ -n "${CF_TUNNEL_TOKEN:-}" ]; then
  install -d -m 700 /etc/cloudflared
  printf '%s' "$CF_TUNNEL_TOKEN" > /etc/cloudflared/token
  chmod 600 /etc/cloudflared/token
  rc-service cf-tunnel start || true
fi

date -u +%FT%TZ > "$MARKER"
echo "firstboot done: $NODE_HOSTNAME $NODE_IP"

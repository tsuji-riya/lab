#!/bin/sh
# 初回起動時のみ: 焼き込み時に注入された node.conf から identity を適用する。
# node.conf の探索先: /boot (Pi の FAT、x86 は ESP が /boot にマウントされる)。
# 途中で失敗したらマーカーを書かずに終わり、次回起動で最初からやり直す。
# そのため各手順は何度流しても同じ結果になるように書く。
set -eu
MARKER=/etc/lab-firstboot-done
[ -f "$MARKER" ] && exit 0

CONF="" CONF_DEV=""
for p in /boot/node.conf /boot/efi/node.conf /media/*/node.conf; do
  [ -f "$p" ] && CONF="$p" && break
done
# /boot に無ければ、起動したディスク (/ と同じディスク) の vfat パーティションを探す。
# mini PC を USB 起動した段階では内蔵ディスクの旧 ESP も刺さっており、fstab の
# LABEL=EFI が別のディスクを /boot に掴むことがある (node1 で node.conf を見落とした、
# 2026-11-26)。全ディスクは探さない: 旧 ESP に古い node.conf が残っていることがある
if [ -z "$CONF" ]; then
  tmp=$(mktemp -d)
  root_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)")
  for dev in $(lsblk -lnpo NAME,FSTYPE "/dev/${root_disk}" | awk '$2 == "vfat" { print $1 }'); do
    mount -o ro "$dev" "$tmp" 2>/dev/null || continue
    if [ -f "$tmp/node.conf" ]; then
      (umask 077 && cp "$tmp/node.conf" /run/node.conf)
      CONF=/run/node.conf CONF_DEV="$dev"
    fi
    umount "$tmp"
    [ -n "$CONF" ] && break
  done
  rmdir "$tmp"
fi
[ -n "$CONF" ] || { echo "node.conf not found (/boot にも起動ディスクの vfat にも無い), skipping"; exit 0; }
echo "node.conf: ${CONF_DEV:-$CONF}"

# NODE_HOSTNAME= / NODE_IP= / NODE_GATEWAY= / NODE_DNS= / NODE_ROLE=
# SSH_PUBKEY= / SSH_PUBKEY_CI= / SSH_HOST_KEY_B64= / CF_TUNNEL_TOKEN= / CF_API_TUNNEL_TOKEN=
# shellcheck source=/dev/null
. "$CONF"
GATEWAY="${NODE_GATEWAY:-192.168.1.1}"

# SSH ホスト鍵は Terraform が台ごとに生成した値を受け取る (焼き直しても不変
# なので known_hosts を作り直す必要が無い)。無ければこの場で生成する
if [ -n "${SSH_HOST_KEY_B64:-}" ]; then
  (umask 077 && echo "$SSH_HOST_KEY_B64" | base64 -d > /etc/ssh/ssh_host_ed25519_key)
  ssh-keygen -y -f /etc/ssh/ssh_host_ed25519_key > /etc/ssh/ssh_host_ed25519_key.pub
elif [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
  ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key
fi

# 管理用公開鍵は node.conf 経由で受け取る (Git にも image にも入れない)。
# CI (Host converge) 用の鍵は本人の鍵と分け、CI だけを失効できるようにする
if [ -n "${SSH_PUBKEY:-}" ]; then
  install -d -m 700 -o riya -g riya /home/riya/.ssh
  {
    echo "$SSH_PUBKEY"
    [ -z "${SSH_PUBKEY_CI:-}" ] || echo "$SSH_PUBKEY_CI"
  } > /home/riya/.ssh/authorized_keys
  chmod 600 /home/riya/.ssh/authorized_keys
  chown riya:riya /home/riya/.ssh/authorized_keys
fi

hostname "$NODE_HOSTNAME"
echo "$NODE_HOSTNAME" > /etc/hostname
cat > /etc/network/interfaces <<EOF
auto lo
iface lo inet loopback
auto eth0
iface eth0 inet static
  address ${NODE_IP}
  netmask 255.255.255.0
  gateway ${GATEWAY}
EOF
# busybox ifupdown は dns-nameservers を解釈しないので resolv.conf を直接書く。
# image にはビルド環境の resolv.conf を残していない (configure-chroot で削除)
{
  for ns in ${NODE_DNS:-$GATEWAY 1.1.1.1}; do echo "nameserver $ns"; done
} > /etc/resolv.conf
grep -q "^${NODE_IP} " /etc/hosts || echo "${NODE_IP} ${NODE_HOSTNAME} ${NODE_HOSTNAME%%.*}" >> /etc/hosts

# root パーティションをディスク末尾まで拡張 (image は 4G で作るため)。
# growpart は使用中パーティションの拡張 (partx で kernel に反映) と、
# x86 の GPT バックアップヘッダの末尾への移動の両方を面倒見る。
# 終了コード 1 は「既に最大」(NOCHANGE) で正常扱い
ROOT_DEV=$(findmnt -no SOURCE /)
DISK=$(lsblk -no PKNAME "$ROOT_DEV")
PARTNO=$(cat "/sys/class/block/$(basename "$ROOT_DEV")/partition")
rc=0
growpart "/dev/$DISK" "$PARTNO" || rc=$?
[ "$rc" -le 1 ] || { echo "growpart failed ($rc)" >&2; exit 1; }
resize2fs "$ROOT_DEV"

# Cloudflare Tunnel。トークンは node.conf 経由で焼き込み時にだけ渡す。
# CF_TUNNEL_TOKEN: 台ごとの SSH 用 (全台) / CF_API_TUNNEL_TOKEN: k3s API 用 (server のみ)
# token を置くだけで、起動は default ランレベルに任せる。ここで rc-service start すると、
# cf-tunnel は need net → networking は before で node-firstboot の完了待ち、の
# 待ち合わせになり 50 秒 x 2 のタイムアウトで起動が止まる (node1、2026-11-26)
install -d -m 700 /etc/cloudflared
for pair in "cf-tunnel:${CF_TUNNEL_TOKEN:-}" "cf-tunnel.api:${CF_API_TUNNEL_TOKEN:-}"; do
  svc=${pair%%:*} token=${pair#*:}
  [ -n "$token" ] || continue
  (umask 077 && printf '%s' "$token" > "/etc/cloudflared/${svc}.token")
done

date -u +%FT%TZ > "$MARKER"
# node.conf はトンネル token を含み、FAT 上で誰でも読める。適用後は消す
rm -f "$CONF"
if [ -n "$CONF_DEV" ]; then
  tmp=$(mktemp -d)
  mount "$CONF_DEV" "$tmp" && rm -f "$tmp/node.conf" && umount "$tmp"
  rmdir "$tmp"
fi
echo "firstboot done: $NODE_HOSTNAME $NODE_IP"
